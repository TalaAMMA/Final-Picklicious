{
  "name": "project",
  "version": "1.0.0",
  "description": "",
  "main": "constants.js",
"scripts": {
  "start": "npx serve prod -l 3000",
    "test": "echo \"Error: no test specified\" && exit 1",
    "mkdirs": "mkdir -p prod/css && mkdir -p prod/pages && mkdir -p prod/images && mkdir -p prod/js",
    "copyPages": "cp -r src/pages/* prod/",
    "copyImages": "cp -r src/images/* prod/images",
    "copyJS": "cp -r src/js/* prod/js",
    "sass:dev": "npx sass --watch src/index.scss src/css/style.css",
    "sass:prod": "npx sass --style=compressed --no-source-map src/index.scss prod/css/style.css",
    "watch": "node esbuild.mjs",
    "prod": "npm run mkdirs && npm run copyImages && npm run copyJS && node esbuild.prod.mjs && npm run sass:prod && npm run copyPages",
    "dev": "npm-run-all --parallel watch sass:dev serve",
    "serve": "npx serve prod -l 3000"
},
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "animate.css": "^4.1.1",
    "esbuild": "^0.17.4",
    "node-forge": "^1.3.1",
    "npm-run-all": "^4.1.5",
    "react": "^18.2.0",
    "react-router-dom": "^6.8.1",
    "sass": "^1.57.1"
  },
  "type": "module"
}
